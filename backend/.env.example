# Database Configuration (COPY THIS TO .env AND EDIT)
DB_USER=postgres
DB_PASSWORD=123
DB_HOST=localhost
DB_PORT=5432
DB_NAME=video_analytics

# Security (Change these for production!)
SECRET_KEY=generate_a_random_long_string_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Video capture settings
CAMERA_SOURCE=0
LOG_INTERVAL_SECONDS=3.0

# SMTP Email Notification Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_SENDER=your_email@gmail.com
ALERT_RECEIVER_EMAIL=

# Alert Routing Configuration
# Select which alert severity levels and user roles will receive email notifications (comma-separated)
ALERT_NOTIFY_SEVERITIES=Critical,High
ALERT_NOTIFY_ROLES=super_admin,admin

# Twilio WhatsApp Settings
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
